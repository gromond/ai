# Practice — environment configuration
# Server-only variables for the Vercel deployment. NEVER commit real secrets.
# The app works fully without any of these; they only enable AI overall feedback.

# API key for the AI provider used by api/feedback.js (overall feedback only).
# Leave empty/unset = AI feedback disabled, results page shows a clear fallback.
AI_FEEDBACK_API_KEY=

# Optional: OpenAI-compatible chat completions endpoint.
# Default: https://api.openai.com/v1/chat/completions
AI_FEEDBACK_API_URL=

# Optional: model name. Default: gpt-4o-mini
AI_FEEDBACK_MODEL=
