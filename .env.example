# Practice — environment configuration template
# Copy to .env for local production-backend work. NEVER commit real secrets.

# --- Database / Auth / Storage (Supabase) ---
# Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe for the browser ONLY when Row Level Security is enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string — SERVER ONLY (migrations, seeds)
DATABASE_URL=

# --- Optional AI providers (server only) ---
# Writing formative feedback provider API key (leave empty = instructor review only)
AI_WRITING_API_KEY=
# Speech transcription / evaluation provider API key (leave empty = instructor review only)
AI_SPEECH_API_KEY=
# Text-to-speech provider for pre-generated listening audio (optional;
# the standalone build uses the device speech voice instead)
TTS_API_KEY=

# --- App ---
# Public base URL of the deployment, e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=
